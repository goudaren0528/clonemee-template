{
  "permissions": {
    "allow": [
      "Bash(python tools/delivery.py allow *)",
      "Bash(python tools/follow.py *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/session_start.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/session_start.py\"",
            "timeout": 90,
            "statusMessage": "加载记忆索引、检查本设备路径"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/stop_check.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/stop_check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/prompt_hook.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/prompt_hook.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/guard_hook.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/guard_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
